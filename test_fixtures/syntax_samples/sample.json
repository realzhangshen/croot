{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application Configuration",
  "description": "Sample JSON exercising all value types: strings, numbers, booleans, null, arrays, nested objects.",
  "version": "2.5.0",
  "debug": false,
  "verbose": true,
  "maxRetries": 3,
  "timeout": 30000,
  "pi": 3.141592653589793,
  "temperature": -273.15,
  "bigNumber": 9007199254740991,
  "scientific": 6.022e23,
  "zero": 0,
  "emptyString": "",
  "nullValue": null,
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "tls": {
      "enabled": true,
      "cert": "/etc/ssl/certs/server.pem",
      "key": "/etc/ssl/private/server.key",
      "minVersion": "TLSv1.3"
    },
    "cors": {
      "origins": ["https://example.com", "https://app.example.com"],
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"],
      "allowCredentials": true,
      "maxAge": 86400
    },
    "rateLimit": {
      "windowMs": 60000,
      "maxRequests": 100,
      "skipPaths": ["/health", "/metrics", "/api/v1/public"]
    }
  },
  "database": {
    "primary": {
      "driver": "postgres",
      "host": "db.internal.example.com",
      "port": 5432,
      "name": "app_production",
      "username": "app_user",
      "pool": {
        "min": 5,
        "max": 20,
        "acquireTimeout": 10000,
        "idleTimeout": 300000
      },
      "ssl": true
    },
    "redis": {
      "url": "redis://cache.internal:6379/0",
      "prefix": "app:",
      "ttl": 3600,
      "cluster": false,
      "sentinels": null
    }
  },
  "auth": {
    "providers": [
      {
        "type": "oauth2",
        "name": "Google",
        "clientId": "123456789.apps.googleusercontent.com",
        "scopes": ["openid", "email", "profile"],
        "callbackUrl": "https://app.example.com/auth/callback/google",
        "enabled": true
      },
      {
        "type": "saml",
        "name": "Corporate SSO",
        "entityId": "urn:example:corp-sso",
        "metadataUrl": "https://sso.corp.example.com/metadata.xml",
        "enabled": false
      }
    ],
    "jwt": {
      "algorithm": "RS256",
      "expiresIn": "15m",
      "refreshExpiresIn": "7d",
      "issuer": "https://auth.example.com",
      "audience": ["api.example.com", "app.example.com"]
    },
    "session": {
      "secret": "CHANGE_ME_IN_PRODUCTION",
      "maxAge": 604800,
      "secure": true,
      "sameSite": "lax"
    }
  },
  "logging": {
    "level": "info",
    "format": "json",
    "transports": [
      {
        "type": "console",
        "colorize": true
      },
      {
        "type": "file",
        "path": "/var/log/app/combined.log",
        "maxSize": "100MB",
        "maxFiles": 10,
        "compress": true
      }
    ],
    "redact": ["password", "secret", "token", "authorization", "cookie"]
  },
  "features": {
    "darkMode": true,
    "betaFeatures": false,
    "maintenanceMode": false,
    "experimentalApi": null,
    "flags": {
      "NEW_DASHBOARD": { "enabled": true, "rollout": 0.5 },
      "REDESIGNED_CHECKOUT": { "enabled": false, "rollout": 0.0 },
      "AI_SUGGESTIONS": { "enabled": true, "rollout": 1.0 }
    }
  },
  "i18n": {
    "defaultLocale": "en-US",
    "supportedLocales": ["en-US", "zh-CN", "ja-JP", "ko-KR", "de-DE", "fr-FR", "es-ES"],
    "fallbackLocale": "en-US",
    "detectBrowserLocale": true
  },
  "metadata": {
    "buildId": "a1b2c3d4e5f6",
    "commit": "f655868abc",
    "branch": "main",
    "builtAt": "2026-04-01T12:00:00.000Z",
    "environment": "production",
    "tags": ["v2.5.0", "stable", "release"],
    "emptyArray": [],
    "emptyObject": {},
    "unicodeTest": "Hello \u4e16\u754c \ud83c\udf0d"
  }
}
