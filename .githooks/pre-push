#!/usr/bin/env bash
# Pre-push hook: mirrors CI checks (fmt, check, clippy, test)
# Skip with: git push --no-verify

set -e

echo "pre-push: running CI checks..."
echo ""

echo "[1/4] cargo fmt --check"
if ! cargo fmt --check 2>/dev/null; then
    echo "✗ Formatting check failed. Run 'cargo fmt' to fix."
    exit 1
fi

echo "[2/4] cargo check"
if ! cargo check --quiet 2>&1; then
    echo "✗ cargo check failed."
    exit 1
fi

echo "[3/4] cargo clippy"
if ! cargo clippy --quiet -- -D warnings 2>&1; then
    echo "✗ clippy found warnings. Run 'cargo clippy' to see details."
    exit 1
fi

echo "[4/4] cargo test"
if ! cargo test --quiet 2>&1; then
    echo "✗ Tests failed."
    exit 1
fi

echo ""
echo "pre-push: all checks passed"
